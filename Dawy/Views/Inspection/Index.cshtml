@model IEnumerable<Dawy.Models.Product>
@{
    ViewData["Title"] = "التبرعات الواردة للمراجعة";
}

<div class="row g-4">
    <!-- القائمة الجانبية للصيدلي -->
    <div class="col-lg-3">
        <div class="dawy-sidebar">
            <div class="d-flex align-items-center gap-2 mb-4 px-2">
                <i class="bi bi-heart-pulse-fill fs-3"></i>
                <div>
                    <div class="fw-bold fs-5 lh-1">داوي</div>
                    <small class="text-white-50" style="font-size: 0.7rem;">بوابة الصيدلي</small>
                </div>
            </div>
            <nav class="nav flex-column">
                <a class="nav-link" asp-controller="Pharmacy" asp-action="MyPharmacies"><i class="bi bi-house-door"></i> الرئيسية</a>
                <a class="nav-link active" asp-controller="Inspection" asp-action="Index"><i class="bi bi-clipboard2-check"></i> التبرعات الواردة</a>
                <a class="nav-link" asp-controller="Category" asp-action="Index"><i class="bi bi-capsule"></i> المنتجات</a>
                <a class="nav-link" asp-controller="Collection" asp-action="Index"><i class="bi bi-bag-check"></i> طلبات المستفيدين</a>
            </nav>
        </div>
    </div>

    <!-- جدول التبرعات الواردة للمراجعة -->
    <div class="col-lg-9">
        <div class="dawy-card p-4">
            <h4 class="fw-bold mb-4">التبرعات الواردة للمراجعة</h4>

            <div class="table-responsive">
                <table class="table align-middle">
                    <thead class="text-muted">
                        <tr>
                            <th>المنتج</th>
                            <th>الكمية</th>
                            <th>تاريخ الاستلام</th>
                            <th class="text-center">الإجراءات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="fw-bold">@item.ProductName</td>
                                <td>@item.Quantity عبوات</td>
                                <td class="text-muted">@item.CreatedAt.ToString("yyyy/MM/dd")</td>
                                <td class="text-center">
                                    <div class="d-inline-flex gap-2">
                                        <form asp-action="Approve" asp-route-id="@item.ProductId" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-teal btn-sm px-3">قبول</button>
                                        </form>
                                        <form asp-action="Reject" asp-route-id="@item.ProductId" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="reason" value="غير مطابق لشروط التخزين" />
                                            <button type="submit" class="btn btn-sm px-3" style="background-color: #fee2e2; color: #991b1b; font-weight:600;">رفض</button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>