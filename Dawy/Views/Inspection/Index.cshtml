@model IEnumerable<Dawy.Models.Product>
@{
    ViewData["Title"] = "فحص ومراجعة التبرعات الدوائية";
    var currentStatus = ViewBag.CurrentStatus as string;
}

<div class="container py-4" dir="rtl">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-primary mb-1">فحص التبرعات الواردة للصيدلية</h2>
            <p class="text-muted mb-0">مراجعة صلاحية وجودة الأدوية المتبرع بها قبل إضافتها للكتالوج العام</p>
        </div>
    </div>

    <!-- فلتر الحالات -->
    <div class="mb-3 d-flex gap-2">
        <a asp-action="Index" asp-route-status="@Dawy.Models.ProductStatus.Pending"
           class="btn btn-sm @(currentStatus == Dawy.Models.ProductStatus.Pending ? "btn-warning" : "btn-outline-warning")">
            بانتظار الفحص (@ViewBag.PendingCount)
        </a>
        <a asp-action="Index" asp-route-status="@Dawy.Models.ProductStatus.Approved"
           class="btn btn-sm @(currentStatus == Dawy.Models.ProductStatus.Approved ? "btn-success" : "btn-outline-success")">
            تم قبولها (@ViewBag.ApprovedCount)
        </a>
        <a asp-action="Index" asp-route-status="@Dawy.Models.ProductStatus.Rejected"
           class="btn btn-sm @(currentStatus == Dawy.Models.ProductStatus.Rejected ? "btn-danger" : "btn-outline-danger")">
            مرفوضة (@ViewBag.RejectedCount)
        </a>
        <a asp-action="Index" asp-route-status="All"
           class="btn btn-sm @(currentStatus == "All" ? "btn-dark" : "btn-outline-dark")">
            الكل
        </a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>الدواء</th>
                        <th>الفئة</th>
                        <th>الكمية</th>
                        <th>تاريخ الصلاحية</th>
                        <th>المتبرع</th>
                        <th>الصيدلية</th>
                        <th>الحالة</th>
                        <th>إجراء الفحص</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center py-4 text-muted">لا توجد تبرعات في هذه القائمة حالياً.</td>
                        </tr>
                    }
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-bold">@item.ProductName</td>
                            <td>@item.Category</td>
                            <td>@item.Quantity</td>
                            <td>@item.ExpiryDate.ToString("yyyy-MM-dd")</td>
                            <td>@(item.Donor?.FullName ?? "-")</td>
                            <td>@(item.Pharmacy?.PharmacyName ?? "-")</td>
                            <td>
                                @if (item.Status == Dawy.Models.ProductStatus.Pending)
                                {
                                    <span class="badge bg-warning text-dark">بانتظار الفحص</span>
                                }
                                else if (item.Status == Dawy.Models.ProductStatus.Approved)
                                {
                                    <span class="badge bg-success">معتمد</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">مرفوض</span>
                                }
                            </td>
                            <td>
                                <a asp-action="Details" asp-route-id="@item.ProductId" class="btn btn-sm btn-primary">
                                    معاينة وفحص
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>