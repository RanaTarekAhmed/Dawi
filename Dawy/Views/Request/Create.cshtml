@model Dawi.ViewModels.RequestViewModel

@{
    ViewData["Title"] = "إرسال طلب دواء";
}

<div class="container mt-4">
    <h2 class="mb-4 text-teal fw-bold">إرسال طلب دواء</h2>

    <div class="dawy-card p-4">
        <form asp-action="Create" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()

            @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
            {
                <div class="alert alert-danger py-2 px-3 small rounded-3 mb-3">
                    <div asp-validation-summary="ModelOnly" class="text-danger m-0"></div>
                </div>
            }

            <input type="hidden" asp-for="ProductId" />

            <div class="mb-3">
                <label class="form-label fw-bold">اسم الدواء</label>
                <input type="text" class="form-control" value="@ViewBag.Product?.ProductName" disabled />
            </div>

            <div class="mb-3">
                <label asp-for="Quantity" class="form-label fw-bold">الكمية المطلوبة</label>
                <input asp-for="Quantity" class="form-control" type="number" min="1" max="@ViewBag.Product?.Quantity" required />
                <small class="text-muted">الكمية المتاحة: @ViewBag.Product?.Quantity</small>
                <span asp-validation-for="Quantity" class="text-danger d-block small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="PrescriptionImage" class="form-label fw-bold">صورة الروشتة</label>
                <input asp-for="PrescriptionImage" type="file" class="form-control" accept=".jpg,.jpeg,.png,.webp,image/*" />
                <span asp-validation-for="PrescriptionImage" class="text-danger d-block small"></span>
            </div>

            <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                <a asp-action="MyRequests" class="btn btn-outline-secondary me-md-2">إلغاء</a>
                <button type="submit" class="btn btn-teal px-4">إرسال الطلب</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}