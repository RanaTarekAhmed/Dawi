@{
    ViewData["Title"] = "الرئيسية";
}

<style>
    .dawy-hero-wrapper {
        position: relative;
        background: linear-gradient(110deg, #e8f5f3 0%, #f1f9f8 50%, #dff0ed 100%);
        border-radius: 16px 16px 0 0;
        overflow: hidden;
        min-height: 430px;
        display: flex;
        align-items: center;
    }

    .dawy-hero-wave {
        position: absolute;
        top: 0;
        bottom: 0;
        right: 46%;
        width: 160px;
        background: rgba(255, 255, 255, 0.45);
        transform: skewX(-12deg);
        border-radius: 50%;
        filter: blur(8px);
        pointer-events: none;
        z-index: 1;
    }

    .dawy-hero-visual {
        position: relative;
        height: 430px;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
    }

    .dawy-hero-photo {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center;
        mask-image: linear-gradient(to right, rgba(0,0,0,1) 78%, rgba(0,0,0,0) 100%);
        -webkit-mask-image: linear-gradient(to right, rgba(0,0,0,1) 78%, rgba(0,0,0,0) 100%);
    }

    .dawy-features-bar {
        background: #ffffff;
        border-radius: 0 0 16px 16px;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.04);
        padding: 32px 16px;
        border-top: 1px solid #edf2f7;
    }

    .dawy-feature-col {
        position: relative;
        text-align: center;
        padding: 8px 16px;
    }

    @@media (min-width: 768px) {
        .dawy-feature-col:not(:last-child)::after {
            content: "";
            position: absolute;
            left: 0;
            top: 15%;
            height: 70%;
            width: 1px;
            background-color: #e2e8f0;
        }
    }

    .dawy-feature-icon {
        width: 58px;
        height: 58px;
        border-radius: 50%;
        border: 1.5px solid #ccebe6;
        background-color: #f4fbf9;
        color: #0f766e;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        margin-bottom: 14px;
    }

    .dawy-hero-title {
        font-size: 2.9rem;
        font-weight: 800;
        color: #0f2926;
        line-height: 1.35;
    }

    .dawy-dots {
        color: #14b8a6;
        letter-spacing: 3px;
    }
</style>

<!-- البانر الرئيسي (Hero Section) -->
<div class="dawy-hero-wrapper shadow-sm">
    <div class="dawy-hero-wave"></div>

    <div class="row w-100 m-0 align-items-center">
        <!-- النص والأزرار (على اليمين) -->
        <div class="col-lg-6 p-4 p-md-5 z-2 text-end">
            <h1 class="dawy-hero-title mb-3">
                أدوية اليوم <span class="dawy-dots">..</span><br />
                صحة لغد أفضل
            </h1>
            <p class="text-secondary fs-5 mb-4" style="line-height: 1.8; max-width: 520px;">
                منصة داوي تربط بين المتبرعين والصيدليات والمستفيدين
                لتوفير الأدوية والمستلزمات الطبية بطريقة آمنة وموثوقة.
            </p>
            <div class="d-flex flex-wrap gap-3 pt-1">
                <a asp-controller="Donation" asp-action="Create"
                   class="btn btn-teal btn-lg px-5 py-2 shadow-sm" style="border-radius: 10px;">
                    ابدأ التبرع الآن
                </a>
                <a asp-controller="Category" asp-action="Index"
                   class="btn btn-lg px-4 py-2 bg-white border"
                   style="border-radius: 10px; color: #1e293b; border-color: #cbd5e1 !important; font-weight: 600;">
                    معرفة المزيد
                </a>
            </div>
        </div>

        <!-- الصورة الفوتوغرافية من المسار wwwroot/Images/hand.jpg -->
        <div class="col-lg-6 p-0 dawy-hero-visual">
            <img src="~/Images/hand.jpg"
                 alt="تبرع بالأدوية - منصة داوي"
                 class="dawy-hero-photo" />
        </div>
    </div>
</div>

<!-- شريط المميزات السفلي المتصل -->
<div class="dawy-features-bar mb-5">
    <div class="row g-4 m-0">
        <div class="col-6 col-md-3 dawy-feature-col">
            <div class="dawy-feature-icon">
                <i class="bi bi-heart-pulse"></i>
            </div>
            <h6 class="fw-bold mb-1">إحداث فرق</h6>
            <p class="text-muted small mb-0">لصحة مجتمعنا</p>
        </div>

        <div class="col-6 col-md-3 dawy-feature-col">
            <div class="dawy-feature-icon">
                <i class="bi bi-truck"></i>
            </div>
            <h6 class="fw-bold mb-1">توزيع آمن</h6>
            <p class="text-muted small mb-0">خلال شبكة من الصيدليات المشاركة</p>
        </div>

        <div class="col-6 col-md-3 dawy-feature-col">
            <div class="dawy-feature-icon">
                <i class="bi bi-shield-plus"></i>
            </div>
            <h6 class="fw-bold mb-1">منتجات معتمدة</h6>
            <p class="text-muted small mb-0">مراجعة من صيدلي مختص</p>
        </div>

        <div class="col-6 col-md-3 dawy-feature-col">
            <div class="dawy-feature-icon">
                <i class="bi bi-people"></i>
            </div>
            <h6 class="fw-bold mb-1">مستخدمين موثوقين</h6>
            <p class="text-muted small mb-0">نظام تحقق من الهوية والأدوار</p>
        </div>
    </div>
</div>