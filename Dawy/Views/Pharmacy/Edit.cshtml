@model Dawy.Models.Pharmacy
@{
    ViewData["Title"] = "تعديل بيانات الصيدلية";
}

<div class="container py-4" dir="rtl">
    <div class="row justify-content-center">
        <div class="col-md-7">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-dark text-white py-3">
                    <h4 class="mb-0 fw-bold">تعديل بيانات: @Model.PharmacyName</h4>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Edit" asp-route-id="@Model.PharmacyId" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="PharmacyId" />
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">اسم الصيدلية</label>
                            <input asp-for="PharmacyName" class="form-control" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">المدينة</label>
                            <input asp-for="City" class="form-control" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">العنوان</label>
                            <input asp-for="Address" class="form-control" />
                        </div>
                        <div class="mb-4">
                            <label class="form-label fw-bold">رقم الهاتف</label>
                            <input asp-for="PhoneNumber" class="form-control" />
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary px-4">حفظ التعديلات</button>
                            <a asp-action="MyPharmacies" class="btn btn-outline-secondary">رجوع</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>