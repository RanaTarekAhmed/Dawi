@model Dawy.Models.Product
@{
    ViewData["Title"] = "تفاصيل الدواء - " + Model.ProductName;
}

<div class="container py-4" dir="rtl">
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index">كتالوج الأدوية</a></li>
            <li class="breadcrumb-item active" aria-current="page">@Model.ProductName</li>
        </ol>
    </nav>

    <div class="card shadow-sm border-0">
        <div class="row g-0">
            <div class="col-md-5 bg-light d-flex align-items-center justify-content-center p-3">
                @if (!string.IsNullOrEmpty(Model.ProductImageUrl))
                {
                    <img src="@Model.ProductImageUrl" class="img-fluid rounded" alt="@Model.ProductName" style="max-height: 350px;" />
                }
                else
                {
                    <div class="text-muted py-5">لا توجد صورة متاحة لهذا الدواء</div>
                }
            </div>
            <div class="col-md-7">
                <div class="card-body p-4">
                    <div class="mb-2">
                        <span class="badge bg-info text-dark fs-6">@Model.Category</span>
                        <span class="badge bg-success fs-6 ms-2">معتمد ومتاح</span>
                    </div>

                    <h2 class="fw-bold mb-3">@Model.ProductName</h2>

                    <ul class="list-group list-group-flush mb-4">
                        <li class="list-group-item px-0 d-flex justify-content-between">
                            <span class="text-muted">الكمية المتوفرة حالياً:</span>
                            <strong class="text-success fs-5">@Model.Quantity عبوة</strong>
                        </li>
                        <li class="list-group-item px-0 d-flex justify-content-between">
                            <span class="text-muted">تاريخ انتهاء الصلاحية:</span>
                            <strong>@Model.ExpiryDate.ToString("yyyy-MM-dd")</strong>
                        </li>
                        @if (Model.Pharmacy != null)
                        {
                            <li class="list-group-item px-0">
                                <div class="text-muted mb-1">صيدلية الاستلام المعتمدة:</div>
                                <div class="fw-bold">@Model.Pharmacy.PharmacyName</div>
                                <div class="small text-muted">@Model.Pharmacy.City - @Model.Pharmacy.Address</div>
                                <div class="small text-muted">هاتف: @Model.Pharmacy.PhoneNumber</div>
                            </li>
                        }
                    </ul>

                    <div class="d-flex gap-3">
                        @if (User.IsInRole(Dawy.Models.Roles.Beneficiary) && Model.Quantity > 0)
                        {
                            <a asp-controller="Request" asp-action="Create" asp-route-productId="@Model.ProductId" class="btn btn-primary btn-lg px-4">
                                طلب هذا الدواء
                            </a>
                        }
                        else if (User.Identity?.IsAuthenticated != true)
                        {
                            <a asp-controller="Account" asp-action="Login" class="btn btn-primary px-4">
                                سجل دخولك كمستفيد لطلب الدواء
                            </a>
                        }
                        <a asp-action="Index" class="btn btn-outline-secondary btn-lg">عودة للكتالوج</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>