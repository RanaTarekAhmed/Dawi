@model IEnumerable<Dawy.Models.Product>
@{
    ViewData["Title"] = "المنتجات";
    var categories = ViewBag.Categories as string[] ?? new[] { "أدوية", "مستلزمات طبية", "فيتامينات", "أجهزة طبية" };
    var currentCategory = ViewBag.CurrentCategory as string;
    var currentSearch = ViewBag.CurrentSearch as string;
    var currentSort = ViewBag.CurrentSort as string;
}

<div class="row g-4">
    <!-- القائمة الجانبية للتصفية (على اليمين كما في الصورة) -->
    <div class="col-lg-3">
        <div class="dawy-card p-4">
            <h5 class="fw-bold mb-4 text-teal">تصفية النتائج</h5>
            <form method="get" asp-action="Index">
                <div class="mb-4">
                    <h6 class="fw-bold mb-3">الفئات</h6>
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="radio" name="category" value="الكل" id="cat_all"
                               checked="@(string.IsNullOrEmpty(currentCategory) || currentCategory == "الكل")" onchange="this.form.submit()">
                        <label class="form-check-label" for="cat_all">الكل</label>
                    </div>
                    @foreach (var cat in categories)
                    {
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="radio" name="category" value="@cat" id="cat_@cat"
                                   checked="@(currentCategory == cat)" onchange="this.form.submit()">
                            <label class="form-check-label" for="cat_@cat">@cat</label>
                        </div>
                    }
                </div>

                <div class="mb-4">
                    <h6 class="fw-bold mb-3">الحالة</h6>
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="checkbox" checked disabled>
                        <label class="form-check-label">متوفر</label>
                    </div>
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="checkbox" disabled>
                        <label class="form-check-label text-muted">قيد المراجعة</label>
                    </div>
                </div>

                <div class="mb-3">
                    <h6 class="fw-bold mb-3">الترتيب حسب</h6>
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="radio" name="sortBy" value="quantity" id="sort_qty"
                               checked="@(currentSort == "quantity")" onchange="this.form.submit()">
                        <label class="form-check-label" for="sort_qty">الأكثر توفراً</label>
                    </div>
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="radio" name="sortBy" value="" id="sort_new"
                               checked="@(string.IsNullOrEmpty(currentSort))" onchange="this.form.submit()">
                        <label class="form-check-label" for="sort_new">الأحدث</label>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- قائمة المنتجات وشريط البحث (على اليسار) -->
    <div class="col-lg-9">
        <form method="get" asp-action="Index" class="mb-4">
            <input type="hidden" name="category" value="@currentCategory" />
            <div class="input-group input-group-lg shadow-sm rounded-3 overflow-hidden">
                <input type="text" name="search" value="@currentSearch" class="form-control border-0" placeholder="ابحث عن اسم الدواء (مثال: باراسيتامول، فيتامين د)..." />
                <button class="btn btn-teal px-4" type="submit"><i class="bi bi-search"></i></button>
            </div>
        </form>

        <div class="d-flex flex-column gap-3">
            @foreach (var item in Model)
            {
                <div class="dawy-card p-3 px-4">
                    <div class="row align-items-center">
                        <div class="col-md-7 d-flex align-items-center gap-3">
                            <div class="bg-teal-light text-teal rounded-3 d-flex align-items-center justify-content-center" style="width: 64px; height: 64px;">
                                <i class="bi bi-capsule-pill fs-2"></i>
                            </div>
                            <div>
                                <h5 class="fw-bold mb-1">@item.ProductName</h5>
                                <div class="text-muted small mb-1">@item.Category @(item.Pharmacy != null ? $"• {item.Pharmacy.PharmacyName}" : "")</div>
                                <span class="text-teal fw-bold small">متوفر - @item.Quantity عبوة</span>
                            </div>
                        </div>
                        <div class="col-md-5 d-flex justify-content-md-end gap-2 mt-3 mt-md-0">
                            <a asp-action="Details" asp-route-id="@item.ProductId" class="btn btn-light border px-4">تفاصيل</a>
                            <a asp-controller="Request" asp-action="Create" asp-route-productId="@item.ProductId" class="btn btn-teal px-4">طلب</a>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>