@model IEnumerable<Dawy.Models.Pharmacy>
@{ ViewData["Title"]="إدارة الصيدليات"; }
<div class="row g-4"><div class="col-lg-3">@await Html.PartialAsync("_AdminSidebar")</div><div class="col-lg-9">
<h2 class="text-teal fw-bold mb-3">اعتماد الصيدليات</h2>
@if(TempData["Success"]!=null){<div class="alert alert-success">@TempData["Success"]</div>} @if(TempData["Error"]!=null){<div class="alert alert-danger">@TempData["Error"]</div>}
<form method="get" class="dawy-card p-3 mb-3 row g-2 align-items-end"><div class="col-md-5"><label class="form-label">اسم الصيدلية أو المدينة</label><input name="search" class="form-control" value="@ViewBag.Search"/></div><div class="col-md-4"><label class="form-label">حالة الاعتماد</label><select class="form-select" name="verified"><option value="">الكل</option><option value="true" selected="@(ViewBag.Verified is bool b && b)">معتمدة</option><option value="false" selected="@(ViewBag.Verified is bool b2 && !b2)">غير معتمدة</option></select></div><div class="col-md-3"><button class="btn btn-teal w-100">تصفية</button></div></form>
<div class="dawy-card p-3 table-responsive"><table class="table align-middle"><thead><tr><th>الصيدلية</th><th>الصيدلي</th><th>المدينة</th><th>التواصل</th><th>الحالة</th><th></th></tr></thead><tbody>
@foreach(var p in Model){<tr><td><strong>@p.PharmacyName</strong><small class="d-block text-muted">@p.Address</small></td><td>@(p.Pharmacist?.FullName??"—")</td><td>@p.City</td><td>@p.PhoneNumber</td><td><span class="badge @(p.IsVerified?"bg-success":"bg-warning text-dark")">@(p.IsVerified?"معتمدة":"بانتظار الاعتماد")</span></td><td><form asp-action="VerifyPharmacy" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@p.PharmacyId"/><input type="hidden" name="verified" value="@(!p.IsVerified)"/><button class="btn btn-sm @(p.IsVerified?"btn-outline-danger":"btn-teal")">@(p.IsVerified?"إلغاء الاعتماد":"اعتماد")</button></form></td></tr>}
</tbody></table></div></div></div>
