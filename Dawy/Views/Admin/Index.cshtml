@{
    ViewData["Title"] = "لوحة الإدارة";
}
<div class="row g-4">
    <div class="col-lg-3">@await Html.PartialAsync("_AdminSidebar")</div>
    <div class="col-lg-9">
        <h2 class="text-teal fw-bold mb-4">إحصائيات المنصة</h2>
        <div class="row g-3">
            <div class="col-md-6 col-xl-4"><div class="dawy-card p-4 h-100"><div class="text-muted">إجمالي المستخدمين</div><h2 class="text-teal fw-bold">@ViewBag.TotalUsers</h2><a asp-action="Users">إدارة المستخدمين</a></div></div>
            <div class="col-md-6 col-xl-4"><div class="dawy-card p-4 h-100"><div class="text-muted">صيدليات معتمدة</div><h2 class="text-success fw-bold">@ViewBag.VerifiedPharmacies</h2><a asp-action="Pharmacies" asp-route-verified="true">عرض المعتمدة</a></div></div>
            <div class="col-md-6 col-xl-4"><div class="dawy-card p-4 h-100"><div class="text-muted">صيدليات غير معتمدة</div><h2 class="text-warning fw-bold">@ViewBag.UnverifiedPharmacies</h2><a asp-action="Pharmacies" asp-route-verified="false">مراجعة الصيدليات</a></div></div>
            <div class="col-md-6 col-xl-4"><div class="dawy-card p-4 h-100"><div class="text-muted">تبرعات معلقة</div><h2 class="text-warning fw-bold">@ViewBag.PendingProducts</h2><a asp-action="Products" asp-route-status="Pending">مراجعتها</a></div></div>
            <div class="col-md-6 col-xl-4"><div class="dawy-card p-4 h-100"><div class="text-muted">تبرعات مقبولة</div><h2 class="text-success fw-bold">@ViewBag.ApprovedProducts</h2><a asp-action="Products" asp-route-status="Approved">عرض المقبولة</a></div></div>
            <div class="col-md-6 col-xl-4"><div class="dawy-card p-4 h-100"><div class="text-muted">تبرعات مرفوضة</div><h2 class="text-danger fw-bold">@ViewBag.RejectedProducts</h2><a asp-action="Products" asp-route-status="Rejected">عرض المرفوضة</a></div></div>
            <div class="col-md-6 col-xl-4"><div class="dawy-card p-4 h-100"><div class="text-muted">إجمالي الطلبات</div><h2 class="fw-bold">@ViewBag.TotalRequests</h2></div></div>
            <div class="col-md-6 col-xl-4"><div class="dawy-card p-4 h-100"><div class="text-muted">الإشعارات غير المقروءة</div><h2 class="fw-bold">@ViewBag.UnreadNotifications</h2></div></div>
        </div>
    </div>
</div>
