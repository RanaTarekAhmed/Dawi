@model List<Dawi.Models.Notification>
@{
    ViewData["Title"] = "الإشعارات";
}

<div class="container my-5" dir="rtl">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="mb-0 text-teal fw-bold">الإشعارات</h3>
        @if (Model.Any(n => !n.IsRead))
        {
            <form asp-action="MarkAllAsRead" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-teal btn-sm">تحديد الكل كمقروء</button>
            </form>
        }
    </div>

    @if (!Model.Any())
    {
        <div class="dawy-card">
            <div class="card-body text-center text-muted py-5">لا توجد إشعارات حتى الآن</div>
        </div>
    }
    else
    {
        <div class="list-group shadow-sm">
            @foreach (var n in Model)
            {
                <div class="list-group-item d-flex justify-content-between align-items-start @(n.IsRead ? "" : "list-group-item-success")">
                    <div class="ms-3">
                        <div class="@(n.IsRead ? "" : "fw-bold")">@n.Title</div>
                        <div class="small text-secondary">@n.Message</div>
                        <small class="text-muted">@n.CreatedAt.ToLocalTime().ToString("yyyy/MM/dd HH:mm")</small>
                    </div>
                    <div class="d-flex gap-2">
                        @if (!string.IsNullOrWhiteSpace(n.Link))
                        {
                            <a href="@n.Link" class="btn btn-sm btn-outline-teal">فتح</a>
                        }
                        @if (!n.IsRead)
                        {
                            <form asp-action="MarkAsRead" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@n.NotificationId" />
                                <button type="submit" class="btn btn-sm btn-outline-secondary">مقروء</button>
                            </form>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>