@model Dawi.Models.ErrorViewModel

@{
    ViewData["Title"] = "خطأ";
}

<h1 class="text-danger">حدث خطأ</h1>
<h2 class="text-danger">حدث خطأ أثناء معالجة طلبك.</h2>

@if (Model.ShowRequestId)
{
    <p>
        <strong>رقم الطلب:</strong> <code>@Model.RequestId</code>
    </p>
}

<h3>وضع التطوير</h3>
<p>في بيئة التطوير يمكن عرض تفاصيل أكثر عن الخطأ. لا يُنصح بتفعيل هذه البيئة عند نشر التطبيق لأنها قد تعرض معلومات حساسة للمستخدمين.</p>

