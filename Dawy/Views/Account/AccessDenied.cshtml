@{
    ViewData["Title"] = "غير مصرح بالدخول";
}

<div class="row justify-content-center align-items-center py-5">
    <div class="col-12 col-md-8 col-lg-6">
        <div class="dawy-card p-5 text-center shadow-sm">
            <div class="mb-4">
                <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-danger bg-opacity-10 text-danger p-4" style="width: 90px; height: 90px;">
                    <i class="bi bi-shield-lock-fill fs-1"></i>
                </div>
            </div>

            <h3 class="fw-bold text-dark mb-2">عذراً.. غير مصرح لك بالدخول</h3>
            <p class="text-muted mb-4 fs-6">
                ليس لديك الصلاحيات الكافية للوصول إلى هذه الصفحة أو تنفيذ هذا الإجراء.
            </p>

            <div class="d-flex justify-content-center gap-3">
                <a asp-controller="Home" asp-action="Index" class="btn btn-teal px-4 py-2">
                    <i class="bi bi-house-door me-1"></i> الصفحة الرئيسية
                </a>
                @if (User.Identity?.IsAuthenticated != true)
                {
                    <a asp-controller="Account" asp-action="Login" class="btn btn-outline-teal px-4 py-2">
                        <i class="bi bi-box-arrow-in-left me-1"></i> تسجيل الدخول
                    </a>
                }
            </div>
        </div>
    </div>
</div>
