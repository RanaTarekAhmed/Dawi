@model Dawy.ViewModels.ProductViewModel
@{
    ViewData["Title"] = "إضافة تبرع جديد";
    var categories = ViewBag.Categories as List<string> ?? new List<string>();
}

<div class="container py-4" dir="rtl">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white py-3">
                    <h4 class="mb-0 fw-bold">التبرع بدواء أو مستلزم طبي</h4>
                </div>
                <div class="card-body p-4">
                    <div class="alert alert-warning small">
                        <strong>تنبيه هام:</strong> لا يُسمح بالتبرع بأدوية الثلاجة (مثل الأنسولين واللقاحات) أو الأدوية المخدرة/الجدول، ويجب أن تكون الصلاحية سارية لمدة 3 أشهر على الأقل.
                    </div>

                    <form asp-action="Create" method="post" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="ProductName" class="form-label fw-bold">اسم الدواء أو المستلزم الطبي</label>
                            <input asp-for="ProductName" class="form-control" placeholder="مثال: بانادول إكسترا 500 مجم" />
                            <span asp-validation-for="ProductName" class="text-danger small"></span>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label asp-for="Category" class="form-label fw-bold">الفئة</label>
                                <select asp-for="Category" class="form-select">
                                    <option value="">-- اختر الفئة --</option>
                                    @foreach (var cat in categories)
                                    {
                                        <option value="@cat">@cat</option>
                                    }
                                </select>
                                <span asp-validation-for="Category" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Quantity" class="form-label fw-bold">الكمية (عدد العبوات)</label>
                                <input asp-for="Quantity" type="number" min="1" class="form-control" />
                                <span asp-validation-for="Quantity" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label asp-for="ExpiryDate" class="form-label fw-bold">تاريخ انتهاء الصلاحية</label>
                                <input asp-for="ExpiryDate" type="date" class="form-control" />
                                <span asp-validation-for="ExpiryDate" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="PharmacyId" class="form-label fw-bold">الصيدلية المعتمدة لتسليم الدواء</label>
                                <select asp-for="PharmacyId" asp-items="ViewBag.Pharmacies" class="form-select">
                                    <option value="">-- اختر الصيدلية --</option>
                                </select>
                                <span asp-validation-for="PharmacyId" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold">صورة واضحة للدواء وتاريخ الصلاحية (اختياري)</label>
                            <input type="file" name="imageFile" class="form-control" accept=".jpg,.jpeg,.png,.webp" />
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-success px-4">إرسال التبرع للمراجعة</button>
                            <a asp-action="Index" class="btn btn-outline-secondary">إلغاء</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}