@model Dawy.ViewModels.ProductViewModel
@{
    ViewData["Title"] = "إضافة تبرع جديد";
    var categories = ViewBag.Categories as List<string> ?? new List<string> { "أدوية", "مستلزمات طبية", "فيتامينات", "أجهزة طبية" };
}

<div class="row justify-content-center my-3">
    <div class="col-md-7 col-lg-6">
        <div class="dawy-card p-4 p-md-5">
            <h3 class="fw-bold text-center mb-4">إضافة تبرع جديد</h3>

            <form asp-action="Create" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Category" class="form-label text-muted small fw-bold">اختر نوع المنتج</label>
                    <select asp-for="Category" class="form-select form-select-lg bg-light border-0">
                        @foreach (var cat in categories)
                        {
                            <option value="@cat">@cat</option>
                        }
                    </select>
                </div>

                <div class="mb-3">
                    <label asp-for="ProductName" class="form-label text-muted small fw-bold">اسم المنتج</label>
                    <input asp-for="ProductName" class="form-control form-control-lg bg-light border-0" placeholder="أدخل اسم المنتج" />
                    <span asp-validation-for="ProductName" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Quantity" class="form-label text-muted small fw-bold">الكمية المتاحة</label>
                    <input asp-for="Quantity" type="number" min="1" class="form-control form-control-lg bg-light border-0" placeholder="الكمية (عدد العبوات)" />
                </div>

                <div class="mb-3">
                    <label asp-for="ExpiryDate" class="form-label text-muted small fw-bold">تاريخ الصلاحية</label>
                    <input asp-for="ExpiryDate" type="date" class="form-control form-control-lg bg-light border-0" />
                    <span asp-validation-for="ExpiryDate" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="PharmacyId" class="form-label text-muted small fw-bold">الصيدلية المستلمة</label>
                    <select asp-for="PharmacyId" asp-items="ViewBag.Pharmacies" class="form-select form-select-lg bg-light border-0">
                        <option value="1">صيدلية الشفاء المعتمدة</option>
                    </select>
                </div>

                <div class="mb-4">
                    <label class="form-label text-muted small fw-bold">ملاحظات أو صورة العبوة (اختياري)</label>
                    <input type="file" name="imageFile" class="form-control bg-light border-0" />
                </div>

                <button type="submit" class="btn btn-teal btn-lg w-100 py-3">إضافة التبرع</button>
            </form>
        </div>
    </div>
</div>