@model Dawi.Models.Product
@using Dawi.Models
@{
    ViewData["Title"] = "تفاصيل التبرع";
}

<div class="row justify-content-center py-3">
    <div class="col-12 col-lg-8">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h4 class="fw-bold text-teal mb-0">تفاصيل التبرع: @Model.ProductName</h4>
            <a asp-action="Index" class="btn btn-outline-teal btn-sm">عودة لتبرعاتي</a>
        </div>

        <div class="dawy-card p-4">
            <div class="row g-4 align-items-center">
                <div class="col-md-4 text-center">
                    @if (!string.IsNullOrWhiteSpace(Model.ProductImageUrl))
                    {
                        <img src="@Model.ProductImageUrl" alt="@Model.ProductName" class="img-fluid rounded border" style="max-height: 240px;" />
                    }
                    else
                    {
                        <div class="bg-light rounded p-5 text-muted small">لا توجد صورة مرفقة</div>
                    }
                </div>
                <div class="col-md-8">
                    <table class="table table-bordered align-middle mb-3">
                        <tr>
                            <th class="bg-light w-35">الفئة</th>
                            <td>@Model.Category</td>
                        </tr>
                        <tr>
                            <th class="bg-light">الكمية</th>
                            <td>@Model.Quantity عبوة</td>
                        </tr>
                        <tr>
                            <th class="bg-light">تاريخ الصلاحية</th>
                            <td>@Model.ExpiryDate.ToString("yyyy/MM/dd")</td>
                        </tr>
                        <tr>
                            <th class="bg-light">الصيدلية المستلمة</th>
                            <td>@(Model.Pharmacy?.PharmacyName ?? "-")</td>
                        </tr>
                        <tr>
                            <th class="bg-light">الحالة</th>
                            <td>
                                @if (Model.Status == ProductStatus.Approved)
                                {
                                    <span class="badge-approved">مقبول</span>
                                }
                                else if (Model.Status == ProductStatus.Rejected)
                                {
                                    <span class="badge-rejected">مرفوض</span>
                                }
                                else if (Model.Status == ProductStatus.Pending)
                                {
                                    <span class="badge-pending">بانتظار فحص الصيدلية</span>
                                }
                                else
                                {
                                    <span class="badge-pending">بانتظار المراجعة الإدارية</span>
                                }
                            </td>
                        </tr>
                        @if (!string.IsNullOrWhiteSpace(Model.RejectionReason))
                        {
                            <tr>
                                <th class="bg-light">سبب الرفض</th>
                                <td class="text-danger">@Model.RejectionReason</td>
                            </tr>
                        }
                    </table>

                    @if ((Model.Status == ProductStatus.Pending || Model.Status == ProductStatus.AdminPending) && User.IsInRole(Roles.Donor))
                    {
                        <form asp-action="Cancel" asp-route-id="@Model.ProductId" method="post">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-outline-danger btn-sm"
                                    onclick="return confirm('هل أنت متأكد من إلغاء هذا التبرع؟')">
                                إلغاء التبرع
                            </button>
                        </form>
                    }
                </div>
            </div>
        </div>
    </div>
</div>