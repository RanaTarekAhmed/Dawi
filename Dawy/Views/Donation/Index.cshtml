@model IEnumerable<Dawy.Models.Product>
@{
    ViewData["Title"] = "لوحة المتبرع";
}

<div class="row g-4">
    <!-- القائمة الجانبية الغامقة زي التصميم -->
    <div class="col-lg-3">
        <div class="dawy-sidebar d-flex flex-column justify-content-between">
            <div>
                <div class="d-flex align-items-center gap-2 mb-4 px-2">
                    <i class="bi bi-heart-pulse-fill fs-3"></i>
                    <div>
                        <div class="fw-bold fs-5 lh-1">داوي</div>
                        <small class="text-white-50" style="font-size: 0.7rem;">معاً .. لصحة أفضل</small>
                    </div>
                </div>
                <nav class="nav flex-column">
                    <a class="nav-link active" asp-controller="Donation" asp-action="Index"><i class="bi bi-house-door"></i> الرئيسية</a>
                    <a class="nav-link" asp-controller="Donation" asp-action="Create"><i class="bi bi-box2-heart"></i> التبرعات</a>
                    <a class="nav-link" asp-controller="Category" asp-action="Index"><i class="bi bi-Grid"></i> المنتجات</a>
                    <a class="nav-link" asp-controller="Pharmacy" asp-action="Index"><i class="bi bi-hospital"></i> الصيدليات</a>
                </nav>
            </div>
            <div class="pt-4 border-top border-secondary">
                <a class="nav-link text-white-50" asp-controller="Home" asp-action="Index"><i class="bi bi-box-arrow-right"></i> عودة للرئيسية</a>
            </div>
        </div>
    </div>

    <!-- محتوى لوحة المتبرع -->
    <div class="col-lg-9">
        <!-- البانر الترحيبي -->
        <div class="dawy-card p-4 mb-4 d-flex justify-content-between align-items-center" style="background: linear-gradient(90deg, #e6f4f1 0%, #ffffff 100%);">
            <div>
                <h4 class="fw-bold mb-1">مرحباً بك، @(User.Identity?.Name ?? "أحمد محمد")</h4>
                <p class="text-muted mb-0">معاً نساهم في توفير الأدوية لمن يحتاجها</p>
            </div>
            <a asp-action="Create" class="btn btn-teal px-4 py-2">+ إضافة تبرع جديد</a>
        </div>

        <!-- الكروت الأربعة للإحصائيات -->
        <div class="row row-cols-2 row-cols-md-4 g-3 mb-4">
            <div class="col">
                <div class="dawy-card p-3 d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small">إجمالي تبرعاتك</div>
                        <h3 class="fw-bold mb-0 mt-1">@ViewBag.TotalDonations</h3>
                    </div>
                    <div class="bg-teal-light text-teal p-2 px-3 rounded-3"><i class="bi bi-person-heart fs-4"></i></div>
                </div>
            </div>
            <div class="col">
                <div class="dawy-card p-3 d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small">الطلبات الحالية</div>
                        <h3 class="fw-bold mb-0 mt-1">@ViewBag.PendingCount</h3>
                    </div>
                    <div class="bg-teal-light text-teal p-2 px-3 rounded-3"><i class="bi bi-hourglass-split fs-4"></i></div>
                </div>
            </div>
            <div class="col">
                <div class="dawy-card p-3 d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small">المنتجات المتاحة</div>
                        <h3 class="fw-bold mb-0 mt-1">@ViewBag.ApprovedCount</h3>
                    </div>
                    <div class="bg-teal-light text-teal p-2 px-3 rounded-3"><i class="bi bi-capsule fs-4"></i></div>
                </div>
            </div>
            <div class="col">
                <div class="dawy-card p-3 d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small">الطلبات المكتملة</div>
                        <h3 class="fw-bold mb-0 mt-1">@ViewBag.ApprovedCount</h3>
                    </div>
                    <div class="bg-teal-light text-teal p-2 px-3 rounded-3"><i class="bi bi-check2-circle fs-4"></i></div>
                </div>
            </div>
        </div>

        <!-- جدول أحدث التبرعات + كارت تبرعك حياة -->
        <div class="row g-4">
            <div class="col-md-8">
                <div class="dawy-card p-4 h-100">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="fw-bold mb-0">أحدث التبرعات</h5>
                        <a asp-action="Index" class="text-teal text-decoration-none small fw-bold">عرض الكل</a>
                    </div>
                    <div class="table-responsive">
                        <table class="table align-middle">
                            <thead class="text-muted small">
                                <tr>
                                    <th>المنتج</th>
                                    <th>الكمية</th>
                                    <th>الحالة</th>
                                    <th>التاريخ</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td class="fw-bold">@item.ProductName</td>
                                        <td>@item.Quantity عبوة</td>
                                        <td>
                                            @if (item.Status == "Approved" || item.Status == "مقبول")
                                            {
                                                <span class="badge-approved">مقبول</span>
                                            }
                                            else if (item.Status == "Rejected" || item.Status == "مرفوض")
                                            {
                                                <span class="badge-rejected">مرفوض</span>
                                            }
                                            else
                                            {
                                                <span class="badge-pending">قيد المراجعة</span>
                                            }
                                        </td>
                                        <td class="text-muted small">@item.CreatedAt.ToString("yyyy/MM/dd")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="dawy-card p-4 text-center h-100 d-flex flex-column justify-content-center align-items-center bg-teal-light border-0">
                    <i class="bi bi-gift-fill text-teal mb-3" style="font-size: 4.5rem;"></i>
                    <h4 class="fw-bold text-teal">تبرعك ... حياة</h4>
                    <p class="text-muted small mb-3">كل دواء تتبرع به قد يكون الأمل لشخص ما</p>
                    <a asp-action="Create" class="btn btn-teal w-100">إضافة تبرع جديد</a>
                </div>
            </div>
        </div>
    </div>
</div>